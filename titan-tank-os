@socketio.on('vector_input')
def handle_vector_input(data):
    if not isinstance(data, dict): return
    if "MANUAL" in state["mode"]:
        try:
            t = float(data.get("throttle", 0.0))
            s = float(data.get("steering", 0.0))
            state["drive"]["throttle"] = max(min(t, 1.0), -1.0)
            state["drive"]["steering"] = max(min(s, 1.0), -1.0)
        except (ValueError, TypeError): pass

@socketio.on('save_mission_profile')
def save_mission(data):
    if not isinstance(data, dict): return
    name = data.get("name", "Surveillance_Cache").strip()
    coords = data.get("coords", [])
    if not name: return
    
    registry = {}
    if os.path.exists(MISSIONS_FILE):
        try:
            with open(MISSIONS_FILE, "r") as f: registry = json.load(f)
        except Exception: pass
    registry[name] = coords
    try:
        with open(MISSIONS_FILE, "w") as f: json.dump(registry, f)
        emit('update_missions_dropdown', list(registry.keys()), broadcast=True)
    except Exception: pass

@socketio.on('sync_missions_dropdown')
def sync_dropdown():
    if os.path.exists(MISSIONS_FILE):
        try:
            with open(MISSIONS_FILE, "r") as f: emit('update_missions_dropdown', list(json.load(f).keys()))
        except Exception: pass

@socketio.on('request_mission_load')
def load_mission(data):
    if not isinstance(data, dict): return
    name = data.get("name")
    if os.path.exists(MISSIONS_FILE):
        try:
            with open(MISSIONS_FILE, "r") as f:
                reg = json.load(f)
                if name in reg: emit('loaded_mission_profile_data', {"name": name, "coords": reg[name]})
        except Exception: pass

@socketio.on('update_mode')
def handle_mode(data): 
    if isinstance(data, dict): state["mode"] = data.get("mode", "MANUAL")

def telemetry_emitter():
    while True:
        socketio.emit('telemetry', {
            "sonar_l": state["sonar_l_cm"], "sonar_r": state["sonar_r_cm"],
            "lat": state["lat"], "lon": state["lon"], "gps_fix": state["gps_fix"],
            "mode": state["mode"], "health": state["health"],
            "lpwm": state["current_left_pwm"], "rpwm": state["current_right_pwm"],
            "pitch": state["pitch_deg"]
        })
        time.sleep(0.1)

