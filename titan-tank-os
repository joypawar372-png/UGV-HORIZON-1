# RC Pulse Width Reader Class
class PulseWidthReader:
    def __init__(self, pi, pin):
        self.pi = pi
        self.pin = pin
        self.tick = None
        self.pulse_width = 1500
        self.pi.set_mode(pin, pigpio.INPUT)
        self.cb = self.pi.callback(pin, pigpio.EITHER_EDGE, self._cbf)
    def _cbf(self, gpio, level, tick):
        if level == 1:
            self.tick = tick
        elif level == 0 and self.tick is not None:
            self.pulse_width = pigpio.tickDiff(self.tick, tick)

frame_buffer = None
frame_lock = threading.Lock()

pi = pigpio.pi()
if not pi.connected:
    log.error("CRITICAL: pigpiod daemon unreachable. System Halting.")
