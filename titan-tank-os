            verifyPeripheralState('chk-gps', data.health.gps);
            verifyPeripheralState('chk-imu', data.health.imu);
            verifyPeripheralState('chk-cam', data.health.camera);
            verifyPeripheralState('chk-rc', data.health.rc_rx);

            if (data.lat !== 0 && data.lon !== 0) {
                const pos = new L.LatLng(data.lat, data.lon);
                tankMarker.setLatLng(pos);
            }
        });

        function initSpringJoystick() {
            const pod = document.getElementById('joystick-pod');
            const manager = nipplejs.create({
                zone: pod, mode: 'static', position: {left: '50%', top: '50%'}, color: '#00ff66', size: 100
            });

            manager.on('move', (evt, data) => {
                if(data && data.distance) {
                    const scalar = Math.min(data.distance / 50, 1.0);
                    const throttle = Math.sin(data.angle.radians) * scalar;
                    const steering = Math.cos(data.angle.radians) * scalar;

                    document.getElementById('lbl-t').innerText = throttle.toFixed(2);
                    document.getElementById('lbl-s').innerText = steering.toFixed(2);

                    socket.emit('vector_input', { throttle: throttle, steering: steering });
                }
            });

            // Automatically snaps back to center on release
            manager.on('end', () => {
                document.getElementById('lbl-t').innerText = "0.00";
                document.getElementById('lbl-s').innerText = "0.00";
                socket.emit('vector_input', { throttle: 0.0, steering: 0.0 });
            });
        }

        function commitMissionProfile() {
            const label = document.getElementById('ms-name').value.trim();
            if(!label) return;
            socket.emit('save_mission_profile', {name: label, coords: waypointCoords});
        }

        function loadMissionProfile() {
            const val = document.getElementById('ms-selector').value;
            if(val) socket.emit('request_mission_load', {name: val});
        }

        socket.on('loaded_mission_profile_data', (data) => {
            wipePathSequence();
            document.getElementById('ms-name').value = data.name;
            data.coords.forEach(pt => logWaypoint(pt.lat, pt.lon));
        });

        socket.on('update_missions_dropdown', (list) => {
            const select = document.getElementById('ms-selector');
            select.innerHTML = '<option value="">-- Load Surveillance Path --</option>';
            list.forEach(m => select.innerHTML += `<option value="${m}">${m}</option>`);
        });

        function changeMode(m) { socket.emit('update_mode', { mode: m }); }

        window.onload = () => { initDjiMap(); initSpringJoystick(); socket.emit('sync_missions_dropdown'); };
    </script>
</body>
</html>
"""

app = Flask(__name__)
socketio = SocketIO(app, cors_allowed_origins="*", async_mode='threading')

@app.route('/')
def route_index(): return render_template_string(UI_TEMPLATE)

def mjpeg_stream_broker():
    global frame_buffer
    while True:
        with frame_lock:
            frame = frame_buffer if frame_buffer is not None else cv2.imencode('.jpg', np.zeros((240, 320, 3), dtype=np.uint8))[1].tobytes()
        yield (b'--frame\r\n' b'Content-Type: image/jpeg\r\n\r\n' + frame + b'\r\n')
        time.sleep(0.04)

@app.route('/video_feed')
def video_feed(): return Response(mjpeg_stream_broker(), mimetype='multipart/x-mixed-replace; boundary=frame')

