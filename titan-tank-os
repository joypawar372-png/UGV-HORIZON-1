def sonar_isolation_polling_worker():
    def execute_ping(trig, echo):
        pi.write(trig, 1)
        time.sleep(0.00001)
        pi.write(trig, 0)
        st = time.time()
        p_start = st
        while pi.read(echo) == 0 and (time.time() - st) < 0.02:
            p_start = time.time()
        et = time.time()
        p_end = p_start
        while pi.read(echo) == 1 and (time.time() - et) < 0.02:
            p_end = time.time()
        dist = ((p_end - p_start) * 34300) / 2.0
        return dist if 2.0 <= dist <= 400.0 else None

    while True:
        l_val = execute_ping(SONAR_L_TRIG, SONAR_L_ECHO)
        if l_val is not None:
            state["sonar_l_cm"] = (state["sonar_l_cm"] * 0.3) + (l_val * 0.7)
            state["health"]["sonar_l"] = "ONLINE"
        else: state["health"]["sonar_l"] = "OFFLINE"
        time.sleep(0.03)

        r_val = execute_ping(SONAR_R_TRIG, SONAR_R_ECHO)
        if r_val is not None:
            state["sonar_r_cm"] = (state["sonar_r_cm"] * 0.3) + (r_val * 0.7)
            state["health"]["sonar_r"] = "ONLINE"
        else: state["health"]["sonar_r"] = "OFFLINE"
        time.sleep(0.03)

def imu_pitch_roll_worker():
    try:
        bus = smbus2.SMBus(1)
        bus.write_byte_data(MPU_ADDR, 0x6B, 0x00) # Wake up sensor
        state["health"]["imu"] = "ONLINE"
    except Exception:
        state["health"]["imu"] = "OFFLINE"
        return

    while True:
        try:
            # Read accelerometer raw registers
            data = bus.read_i2c_block_data(MPU_ADDR, 0x3B, 6)
            ax = np.int16((data[0] << 8) | data[1]) / 16384.0
            ay = np.int16((data[2] << 8) | data[3]) / 16384.0
            az = np.int16((data[4] << 8) | data[5]) / 16384.0
            
            # Extract roll and pitch metrics mathematically
            state["pitch_deg"] = math.atan2(ay, math.sqrt(ax*ax + az*az)) * 57.2958
            state["roll_deg"] = math.atan2(-ax, az) * 57.2958
            state["health"]["imu"] = "ONLINE"
        except Exception:
            state["health"]["imu"] = "ERROR"
        time.sleep(0.04)

def gps_parser_worker():
    port = "/dev/ttyS0" if os.path.exists("/dev/ttyS0") else "/dev/ttyAMA0"
    try:
        ser = serial.Serial(port, baudrate=9600, timeout=0.5)
        state["health"]["gps"] = "ONLINE (NO FIX)"
    except Exception:
        state["health"]["gps"] = "OFFLINE"
        return

    while True:
        try:
            line = ser.readline().decode('ascii', errors='ignore').strip()
            if line.startswith(('$GPRMC', '$GNRMC')):
                parts = line.split(',')
                if len(parts) >= 7 and parts[2] == 'A':
                    raw_lat, lat_dir, raw_lon, lon_dir = parts[3], parts[4], parts[5], parts[6]
                    lat = (float(raw_lat[:2]) + float(raw_lat[2:]) / 60.0) * (-1 if lat_dir == 'S' else 1)
                    lon = (float(raw_lon[:3]) + float(raw_lon[3:]) / 60.0) * (-1 if lon_dir == 'W' else 1)
                    
                    state["lat"], state["lon"], state["gps_fix"] = lat, lon, 1
                    state["health"]["gps"] = "ONLINE (3D LOCK)"
                else:
                    state["gps_fix"] = 0
                    state["health"]["gps"] = "ONLINE (NO FIX)"
        except Exception: pass
        time.sleep(0.05)

def camera_stream_worker():
    global frame_buffer
    cmd = ["rpicam-vid", "-t", "0", "--inline", "--width", "320", "--height", "240", "--codec", "mjpeg", "-o", "-", "--nopreview"]
    try:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        byte_stream = b""
        state["health"]["camera"] = "ONLINE"
        while True:
            chunk = proc.stdout.read(4096)
            if not chunk: break
            byte_stream += chunk
            s = byte_stream.find(b'\xff\xd8')
            e = byte_stream.find(b'\xff\xd9')
            if s != -1 and e != -1 and e > s:
                jpg_bytes = byte_stream[s:e+2]
                byte_stream = byte_stream[e+2:]
                img = cv2.imdecode(np.frombuffer(jpg_bytes, dtype=np.uint8), cv2.IMREAD_COLOR)
                if img is not None:
                    # Vision Line-Tracking Overlay Simulation
                    h, w = img.shape[:2]
                    cv2.line(img, (w // 2, 0), (w // 2, h), (0, 255, 255), 1)
                    _, encoded = cv2.imencode('.jpg', img)
                    with frame_lock:
                        frame_buffer = encoded.tobytes()
    except Exception: state["health"]["camera"] = "OFFLINE"

