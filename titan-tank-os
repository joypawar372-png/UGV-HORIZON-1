def bldc_arming_handshake_sequence():
    state["armed"] = False
    state["health"]["motor_l"] = "ARMING"
    state["health"]["motor_r"] = "ARMING"
    
    pi.set_servo_pulsewidth(MOTOR_LEFT, 1500)
    pi.set_servo_pulsewidth(MOTOR_RIGHT, 1500)
    time.sleep(2.0)
    pi.set_servo_pulsewidth(MOTOR_LEFT, 1000)
    pi.set_servo_pulsewidth(MOTOR_RIGHT, 1000)
    time.sleep(2.0)
    pi.set_servo_pulsewidth(MOTOR_LEFT, 1500)
    pi.set_servo_pulsewidth(MOTOR_RIGHT, 1500)
    time.sleep(1.0)
    
    state["armed"] = True
    state["health"]["motor_l"] = "ONLINE"
    state["health"]["motor_r"] = "ONLINE"
    log.info("Structural Powertrain Safety Calibration Array online.")

def motor_kinematics_controller():
    bldc_arming_handshake_sequence()
    
    # Internal track state variables for acceleration smoothing
    smooth_t = 0.0
    smooth_s = 0.0
    
    while True:
        # Check Hardware Remote Control Status / Mode Toggle Switch (Ch 5)
        # 1000-1300: MANUAL (RC), 1400-1600: MANUAL (WEB), 1700-2100: AUTO
        ch5_val = rc_ch5.pulse_width
        if 900 <= ch5_val <= 2100:
            state["health"]["rc_rx"] = "ONLINE"
            if ch5_val < 1350:
                state["mode"] = "MANUAL_RC"
            elif ch5_val < 1650:
                if state["mode"] == "MANUAL_RC": state["mode"] = "MANUAL"
        else:
            state["health"]["rc_rx"] = "OFFLINE"

        # Arbitrate Target Inputs based on active mode
        if state["mode"] == "MANUAL_RC":
            raw_rc_t = (rc_ch2.pulse_width - 1500) / 500.0
            raw_rc_s = (rc_ch1.pulse_width - 1500) / 500.0
            target_throttle = max(min(raw_rc_t, 1.0), -1.0)
            target_steering = max(min(raw_rc_s, 1.0), -1.0)
        elif state["mode"] == "MANUAL":
            target_throttle = state["drive"]["throttle"]
            target_steering = state["drive"]["steering"]
        elif state["mode"] == "AUTONOMOUS_PATH":
            target_throttle = 0.20
            target_steering = - (state["path_error"] / 160.0) * 1.2
        else:
            target_throttle, target_steering = 0.0, 0.0

        # Dynamic Obstacle Proportional Slowdown Overlay
        min_sonar = min(state["sonar_l_cm"], state["sonar_r_cm"])
        if min_sonar < 80.0 and target_throttle > 0:
            # Scale forward speed down safely based on distance
            factor = max(0.0, (min_sonar - 20.0) / 60.0)
            target_throttle *= factor
            # Inject defensive steering bypass
            if state["sonar_l_cm"] < state["sonar_r_cm"]:
                target_steering += 0.35 * (1.0 - factor)
            else:
                target_steering -= 0.35 * (1.0 - factor)

        # Gyro Slope Adaptation Modifier
        # Compensates for hills to minimize gear fatigue
        if abs(state["pitch_deg"]) > 4.0:
            pitch_contribution = (state["pitch_deg"] / 45.0) * 0.15
            target_throttle += pitch_contribution

        # Bounded Structural Envelope Clamping
        target_throttle = max(min(target_throttle, MAX_RPM_THROTTLE_CEILING), -MAX_RPM_THROTTLE_CEILING)
        target_steering = max(min(target_steering, 0.5), -0.5)

        # Anti-Jerk Slew Rate Filter Integration
        dt_t = target_throttle - smooth_t
        dt_s = target_steering - smooth_s
        smooth_t += max(min(dt_t, SLEW_RATE_LIMIT), -SLEW_RATE_LIMIT)
        smooth_s += max(min(dt_s, SLEW_RATE_LIMIT), -SLEW_RATE_LIMIT)

        # Kinematic Track Mixing Matrix
        if abs(smooth_t) < 0.05 and abs(smooth_s) > 0.15:
            # Explicit Zero-Radius Pivot Turn Execution
            left_mix = smooth_s
            right_mix = -smooth_s
        else:
            # Smooth Blended Flow Turn Curve Mechanics
            if smooth_s >= 0:  # Turning Right: Slow down right track, accelerate left
                left_mix = smooth_t + (smooth_s * 0.4)
                right_mix = smooth_t - (smooth_s * 0.6)
            else:             # Turning Left: Slow down left track, accelerate right
                left_mix = smooth_t + (smooth_s * 0.6)
                right_mix = smooth_t - (smooth_s * 0.4)

        left_pwm = int(1500 + left_mix * 500)
        right_pwm = int(1500 - right_mix * 500) # Inverted for bidirectional matching configuration

        left_pwm = max(min(left_pwm, 2000), 1000)
        right_pwm = max(min(right_pwm, 2000), 1000)

        state["current_left_pwm"] = left_pwm
        state["current_right_pwm"] = right_pwm

        if state["armed"]:
            pi.set_servo_pulsewidth(MOTOR_LEFT, left_pwm)
            pi.set_servo_pulsewidth(MOTOR_RIGHT, right_pwm)
        time.sleep(0.02)

